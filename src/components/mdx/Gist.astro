---
interface Props {
  id: string;
  file?: string;
  showHint?: boolean;
}

const { id, file, showHint = false } = Astro.props;
const query = file ? new URLSearchParams({ file }) : "";
---
<style>
  p {
    font-size: small;
    color: hsl(0, 0%, 50%);
  }
</style>
<script
  is:inline
  cross-origin="anonymous"
  src={`https://gist.github.com/flq/${id}.js${
    query ? "?" + query.toString() : ""
  }`}
></script>
{showHint && <p>Gist not showing up? Most likely you're using Chrome. Reload the page to see the gist.</p> }
