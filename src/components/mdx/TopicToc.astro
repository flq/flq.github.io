---
import { getCollection } from "astro:content";
import { byDateAscending } from "../utils";

interface Props {
  title?: string;
  closed?: boolean;
  active: string;
  topicId: string;
}
const { topicId, active, title = "In this series", closed = false } = Astro.props;
const articles = await getCollection("blog");
const entries = articles
  .filter((a) => a.data.topic == topicId)
  .sort(byDateAscending);
---

<style lang="scss">
  details {
    --details-border-radius: 10px;
    border-radius: var(--details-border-radius);
    font-size: smaller;
    background: #f9f9f9;
    @media (prefers-color-scheme: dark) {
      background: #272822;
    }

    &:not([open]) summary {
      border-bottom-left-radius: var(--details-border-radius);
      border-bottom-right-radius: var(--details-border-radius);
    }
  }

  summary {
    display: list-item;
    background-color: var(--linkColor);
    color: white;
    padding-left: 1rem;

    border-top-left-radius: var(--details-border-radius);
    border-top-right-radius: var(--details-border-radius);

    &:hover {
      cursor: pointer;
    }

    & span {
      display: inline-block;
      margin-left: 1rem;
    }
  }

  ol {
    list-style-type: upper-roman;
    margin-top: 0;
    margin: 1rem;
    padding-bottom: 1rem;
    list-style-position: outside;
  }
</style>

<details open={!closed}>
  <summary>
    <span>{title}</span>
  </summary>
  <ol>
    {
      entries.map(({ id, data: { title } }) => {
        return (
          <li>
            {title == active ? (
              <span>{title}</span>
            ) : (
              <a href={`/posts/${id}`}>{title}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</details>
