---
interface Props {
  mastodonRef: string;
}

const host = "freiburg.social";
const userName = "flq";
const { mastodonRef } = Astro.props;
const url = `https://${host}/@${userName}/${mastodonRef}`;
/*
  Breakpoints used here are taken from _common.scss
  If using scss all css would have to be applied via specific global classes
  as the dynamically generated DOM does not know about the special attributes etc. 
  created by Astro
*/
---

<style>
  hr {
    margin-top: 4rem;
  }

  .info {
    padding: 0 1rem 0.5rem 1rem;
    font-size: 0.6em;
    font-style: italic;
    opacity: 0.9;
  }

  a.reply {
    display: block;
    text-align: center;
    text-decoration: none;
    border: 1px solid var(--linkColor);
    color: var(--linkColor);
    padding: 0.5rem;
    border-radius: 10px;
    margin-right: 2rem;
  }

  section {
    width: 100%;
    article {
      margin-top: 1rem;
      margin-right: 2rem;
      border: 1px solid var(--separatorColor);
      border-radius: 10px;
      padding: 1rem;
      overflow-x: hidden;

      header {
        display: grid;
        gap: 1rem;
        grid-template-rows: 1.2rem 1.2rem;
        grid-template-columns: 1fr auto;
        grid-template-areas:
          "name time"
          "instance time";

        @media (width >= 500px) {
          grid-template-columns: auto 1fr auto;
          grid-template-areas:
            "avatar name time"
            "avatar instance time";
        }

        & > * {
          line-height: 1.2rem;
          padding: 0;
          margin: 0;
        }

        [data-avatar] {
          display: none;

          @media (width >= 500px) {
            display: block;
          }

          grid-area: avatar;
          align-self: self-start;

          img {
            margin: 0;
            width: 60px;
            aspect-ratio: 1;
            border-radius: 50%;
            box-shadow: none;
          }
        }

        span {
          grid-area: name;
        }

        [data-instance] {
          grid-area: instance;
          font-size: medium;
        }

        time {
          font-size: medium;
          grid-area: time;
          text-align: right;
          align-self: start;

          a {
            text-decoration: none;
          }
        }
      }
    }

    article[data-owner] {
      margin-right: 0;
      margin-left: 2rem;
    }
  }
</style>
<hr />
<section
  id="comments"
  data-host={host}
  data-user={userName}
  data-id={mastodonRef}
>
  <h3>Comments</h3>
  <p class="info">
    With an account on the Fediverse or Mastodon, you can respond to this <a
      href={url}>post</a
    >. Since the Fediverse is decentralized, you can use your existing account
    hosted by another Mastodon server or compatible platform if you don't have
    an account on this one. Known non-private replies are displayed below.
  </p>

  <a class="reply" href={url} target="_blank"
    >Reply to this blog post via mastodon</a
  >

  <div id="comments-container">
    <noscript
      ><p>
        Loading comments relies on JavaScript. Try enabling JavaScript and
        reloading, or visit <a href={url}>the original post</a> on Mastodon.
      </p>
    </noscript>
  </div>

  <script
    type="text/javascript"
    src="https://unpkg.com/dompurify@1.0.8/dist/purify.min.js"></script>
  <script>
    const formatter = new Intl.DateTimeFormat(navigator.language, {
      dateStyle: "short",
      timeStyle: "short",
    });
    const commentSection = document.getElementById("comments")!;
    const commentsContainer = document.getElementById("comments-container")!;
    const host = commentSection.dataset["host"]!;
    const userName = commentSection.dataset["user"]!;
    const id = commentSection.dataset["id"]!;

    (async () => {
      const commentsWrapper = document.getElementById("comments-container")!;

      try {
        const response = await fetch(
          `https://${host}/api/v1/statuses/${id}/context`
        );
        if (response.status !== 200) {
          switch (response.status) {
            case 404:
              throw new Error("The referenced post was not found.");
            default:
              throw new Error(`Error status ${response.status}`);
          }
        }
        const data = await response.json();
        let descendants = data["descendants"];

        if (!Array.isArray(descendants) || descendants.length === 0) {
          commentsWrapper.innerHTML = "No discussion found";
          descendants = [];
        }

        var parser = new DOMParser();

        descendants.forEach((status: any) => {
          commentsWrapper.appendChild(createComment(status, parser));
        });
      } catch (error: any) {
        commentsContainer.innerHTML = error.message;
      }
    })();

    function createComment(status: any, parser: DOMParser) {
      if (status.account.display_name.length > 0) {
        status.account.display_name = escapeHtml(status.account.display_name);
        status.account.display_name = emojify(
          status.account.display_name,
          status.account.emojis
        );
      } else {
        status.account.display_name = status.account.username;
      }

      const instance: string = status.account.acct.includes("@")
        ? status.account.acct.split("@")[1]
        : host;

      const isReply = status.in_reply_to_id !== id;

      let blogOwner = status.account.acct == userName;

      status.content = emojify(status.content, status.emojis);

      let comment = `
        <article id="comment-${status.id}" ${isReply ? "data-reply" : ""} ${blogOwner ? "data-owner" : ""}>
          <header>
            <a data-avatar target="_blank" href="${status.account.url}" rel="external nofollow" title="View profile at @${status.account.username}@${instance}">
              <picture>
                <source srcset="${escapeHtml(status.account.avatar)}" media="(prefers-reduced-motion: no-preference)" />
                <img src="${escapeHtml(status.account.avatar_static)}" alt="@${status.account.username}@${instance} avatar" />
              </picture>
            </a>
            <span>
              ${status.account.display_name}
            </span>
            <a data-instance href="${status.account.url}" target="_blank" title="@${status.account.username}@${instance}" rel="external nofollow">
              ${instance}
            </a>
            <time datetime="${status.created_at}">
              <a href="${status.url}" target="_blank" title="View comment at ${instance}" rel="external nofollow">
                ${formatter.format(new Date(status.created_at))}
              </a>
            </time>
          </header>
          <main>
            ${status.content}
          </main>
        </article>
      `;

      const dp = (window as any).DOMPurify;
      if (dp) {
        comment = dp.sanitize(comment);
      }

      return parser.parseFromString(comment, "text/html").body
        .firstElementChild!;
    }

    function escapeHtml(unsafe: string) {
      return unsafe
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function emojify(
      input: string,
      emojis: { url: string; static_url: string; shortcode: string }[]
    ) {
      let output = input;

      emojis.forEach((emoji) => {
        let picture = document.createElement("picture");

        let source = document.createElement("source");
        source.setAttribute("srcset", escapeHtml(emoji.url));
        source.setAttribute("media", "(prefers-reduced-motion: no-preference)");

        let img = document.createElement("img");
        img.className = "emoji";
        img.setAttribute("src", escapeHtml(emoji.static_url));
        img.setAttribute("alt", `:${emoji.shortcode}:`);
        img.setAttribute("title", `:${emoji.shortcode}:`);
        img.setAttribute("width", "20");
        img.setAttribute("height", "20");

        picture.appendChild(source);
        picture.appendChild(img);

        output = output.replace(`:${emoji.shortcode}:`, picture.outerHTML);
      });

      return output;
    }
  </script>
</section>
