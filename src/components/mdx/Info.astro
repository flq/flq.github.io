---
interface Props {
  icon?: boolean;
  header?: string;
}
const { icon = true, header } = Astro.props;
---

<style>
    aside {
        display: block;
    }

    div, details {
        font-weight: 500;
        position: relative;
        background: rgb(198, 248, 255);
        color: black;
        border-left: 10px solid var(--linkColor);
        padding: 0.5rem 2rem;
        box-shadow: var(--standardShadow);
        
        quotes: "\201C" "\201D" "\2018" "\2019";
    }

    div > p {
        margin: 0;
    }

    div.icon:before {
        position: absolute;
        left: 5px;
        top: 5px;
        color: var(--linkColor);
        content: "ⓘ";
        font-size: 6em;
        line-height: 1em;
        opacity: 0.4;
        z-index: 0;
    }

    summary {
        font-size: large;
        font-style: italic;
        cursor: pointer;
        position: relative;
        padding-left: 1.5em;
        list-style: none;
    }

    summary::before {
        content: "▶";
        position: absolute;
        left: 0;
        top: 50%;
        font-style: normal;
        transform: translateY(-50%);
        transition: transform 0.2s ease;
        font-size: 0.8em;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    details[open] summary::before {
        transform: translateY(-50%) rotate(90deg);
    }
</style>

{header ? <aside>
    <details>
        <summary>{header}</summary>
        <p>
            <slot />
        </p>
    </details>
</aside> : (<aside>
    <div class=`${icon && "icon"}`><slot /></div>
</aside>)
}

