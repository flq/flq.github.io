---
interface Props {
  repo: string;
  file: string;
  start?: number;
  end?: number;
  branch?: string;
  user?: string;
  showHint?: boolean;
}

const { showHint = false, user = "flq", repo, branch = "develop", file, start, end } = Astro.props;
const lines = start && end ? `#L${start}-L${end}` : ''

const query = new URLSearchParams({
  target: `https://github.com/${user}/${repo}/blob/${branch}/${file}${lines}`,
  style: "night-owl",
  showBorder: "on",
  showLineNumbers: "on",
  showFileMeta: "on",
  showCopy: "on",
});

---

<style>
  p {
    font-size: small;
    color: hsl(0, 0%, 50%);
  }
</style>

<script
  is:inline
  cross-origin="anonymous"
  src={`https://emgithub.com/embed-v2.js?${query.toString()}`}
></script>
{showHint && <p>Gist not showing up? Most likely you're using Chrome. Reload the page to see the gist.</p> }
